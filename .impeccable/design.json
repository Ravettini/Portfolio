  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary button extracted from app/os.css.",
      "html": "<button class=\"ds-primary\">Escribir un email</button>",
      "css": ".ds-primary{font-family:-apple-system,BlinkMacSystemFont,sans-serif;border:0;cursor:pointer;display: inline-flex;\n  justify-content: center;\n  align-items: center;\n  gap: 7px;\n  font-size: 11px !important;\n  font-weight: 500 !important;\n  padding: 9px 13px;\n  min-height: 34px;\n  line-height: 1.35;\n  border-radius: 6px;\n  background: var(--os-soft,#edf1f8);\n  color: var(--os-ink,#182238) !important;\n  text-align: center;\n  transition:\n    background 0.15s,\n    filter 0.15s;color: #fff !important;\n  background: var(--os-blue,#0757ed);\n  box-shadow: 0 3px 8px #0757ed1a;}.ds-primary:hover{background: #064bcf;\n  filter: none;}.ds-primary:focus-visible{outline:3px solid #3287ff;outline-offset:4px;}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Secondary button extracted from app/os.css.",
      "html": "<button class=\"ds-secondary\">Copiar email</button>",
      "css": ".ds-secondary{font-family:-apple-system,BlinkMacSystemFont,sans-serif;border:0;cursor:pointer;display: inline-flex;\n  justify-content: center;\n  align-items: center;\n  gap: 7px;\n  font-size: 11px !important;\n  font-weight: 500 !important;\n  padding: 9px 13px;\n  min-height: 34px;\n  line-height: 1.35;\n  border-radius: 6px;\n  background: var(--os-soft,#edf1f8);\n  color: var(--os-ink,#182238) !important;\n  text-align: center;\n  transition:\n    background 0.15s,\n    filter 0.15s;}.ds-secondary:hover{filter:brightness(.95)}.ds-secondary:focus-visible{outline:3px solid #3287ff;outline-offset:4px;}"
    },
    {
      "name": "Project launcher",
      "kind": "custom",
      "refersTo": "app-icon",
      "description": "48px semantic launcher icon, used by nine projects and the Utilidades folder. After a 6px threshold, held drag follows the pointer freely in a temporary preview with opacity .85; positions and storage commit to free grid slots only on release. Cancellation/Escape discards preview. Ctrl/Cmd-click or Ctrl/Cmd-Space toggles selection; background marquee selects intersecting 94px targets. Dragging a selected icon moves the group, keeping formation when free space allows. Alt+arrows moves one slot or three with Shift. Preview shows resting appearance.",
      "html": "<button class=\"ds-launcher\"><span class=\"ds-icon\"><svg width=\"29\" height=\"29\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M18 7V4H6l6 8-6 8h12v-3\"/></svg></span><span class=\"ds-label\">SIGMA</span></button>",
      "css": ".ds-launcher{font-family:-apple-system,BlinkMacSystemFont,sans-serif;cursor:pointer;border:0;width: 94px;\n  height: 94px;\n  background: transparent;\n  display: flex;\n  align-items: center;\n  flex-direction: column;\n  gap: 7px;\n  border-radius: 7px;\n  padding: 5px 2px;\n  color: #fff !important;\n  text-align: center;\n  user-select: none;}.ds-launcher:hover{background:#ffffff12}.ds-launcher:focus-visible{outline:3px solid #3287ff;outline-offset:4px;}.ds-launcher:active .ds-icon{filter:brightness(.8)}.ds-icon{filter: brightness(0.8);--icon-top:#b67aff;--icon-bottom:#6136df}.ds-label{max-width: 94px;\n  font-size: 11px;\n  font-weight: 500;\n  line-height: 1.35;\n  text-shadow: 0 1px 4px #000a;}"
    },
    {
      "name": "Technology chip",
      "kind": "chip",
      "refersTo": "technology-chip",
      "description": "Technology chip extracted from app/os.css.",
      "html": "<span class=\"ds-chip\">Next.js</span>",
      "css": ".ds-chip{font-family:-apple-system,BlinkMacSystemFont,sans-serif;display:inline-block;line-height:1.55;font-size: 9px;\n  color: var(--os-muted,#56617a);\n  padding: 3px 7px;\n  background: var(--os-soft,#edf1f8);\n  border-radius: 4px;}"
    },
    {
      "name": "Application window",
      "kind": "card",
      "refersTo": "window",
      "description": "Application window extracted from app/os.css.",
      "html": "<section class=\"ds-window\"><header class=\"ds-bar\"><button class=\"ds-close\" aria-label=\"Cerrar\"></button><span>Notas</span></header><div class=\"ds-content\">Ignacio Ravettini Novellino</div></section>",
      "css": ".ds-window{font-family:-apple-system,BlinkMacSystemFont,sans-serif;border-radius:12px;background:var(--os-surface,#fafafa);color:var(--os-ink,#182238);overflow:hidden;box-shadow:0 24px 65px #00123655,0 5px 18px #00123626}.ds-bar{display:flex;align-items:center;gap:18px;height:42px;padding:0 14px;background:var(--os-chrome,#eeeff2);font-size:11px;font-weight:600}.ds-close{position:relative;display:grid;place-items:center;width:24px;height:28px;padding:0;border:0;border-radius:6px;background:transparent;cursor:pointer}.ds-close:before{content:\"\";width:12px;height:12px;border-radius:50%;background:#ff6059;box-shadow:inset 0 0 0 1px #0000000f}.ds-close:focus-visible{outline:3px solid #3287ff;outline-offset:4px;}.ds-content{padding:23px 30px;font-size:13px;line-height:1.55}"
    },
    {
      "name": "Search input",
      "kind": "input",
      "refersTo": "window",
      "description": "Search input extracted from app/os.css.",
      "html": "<div class=\"ds-search\"><input aria-label=\"Buscar aplicaciones\" placeholder=\"Buscar proyectos y aplicaciones\"/></div>",
      "css": ".ds-search{display:flex;align-items:center;gap:14px;padding:17px 20px;background:var(--os-surface,#fafafa);color:var(--os-ink,#182238);border-bottom:1px solid var(--os-line,#dce0e8)}.ds-search input{font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-size:17px;color:inherit;background:transparent;border:0;outline:none;width:100%;min-width:0;caret-color:var(--os-blue,#0757ed)}.ds-search input::placeholder{color:var(--os-muted,#56617a);opacity:1}"
    },
    {
      "name": "Menu item",
      "kind": "nav",
      "refersTo": "button-secondary",
      "description": "Menu item extracted from app/os.css.",
      "html": "<nav class=\"ds-menu\" aria-label=\"Aplicaciones\"><button>Contacto</button></nav>",
      "css": ".ds-menu{width:250px;padding:6px;background:var(--os-surface,#fafafa);border-radius:9px;box-shadow:0 12px 35px #020b2b50}.ds-menu button{font-family:-apple-system,BlinkMacSystemFont,sans-serif;cursor:pointer;width:100%;display:flex;align-items:center;justify-content:space-between;padding:8px 10px;text-align:left;border:0;border-radius:5px;background:transparent;color:var(--os-ink,#182238);font-size:12px}.ds-menu button:hover{background:var(--os-blue,#0757ed);color:#fff}.ds-menu button:focus-visible{outline:3px solid #3287ff;outline-offset:4px;}"
    },
    {
      "name": "Visitor selection",
      "kind": "button",
      "refersTo": "login-user",
      "description": "Single password-free visitor choice over the blue login wallpaper.",
      "html": "<button class=\"ds-visitor\" aria-label=\"Entrar como visitante\"><span class=\"ds-avatar\"><svg width=\"43\" height=\"43\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"/><circle cx=\"12\" cy=\"7\" r=\"4\"/></svg></span><span class=\"ds-visitor-name\">Visitante</span><span class=\"ds-visitor-description\">Proyectos, ideas y un poco de código.</span><span class=\"ds-enter\">Entrar al escritorio</span></button>",
      "css": ".ds-visitor{font-family:-apple-system,BlinkMacSystemFont,sans-serif;color:#f2f6ff;border:0;cursor:pointer;display: flex;\n  flex-direction: column;\n  align-items: center;\n  background: transparent;\n  margin: auto;\n  padding: 10px 26px;\n  border-radius: 15px;}.ds-avatar{background: #edf5ff3b;\n  box-shadow:\n    inset 0 0 0 2px #edf5ff9c,\n    0 12px 32px #00102c33;}.ds-visitor:hover .ds-avatar,.ds-visitor:focus-visible .ds-avatar{background:#edf5ff3b;box-shadow:inset 0 0 0 2px #edf5ff9c,0 12px 32px #00102c33}.ds-visitor:focus-visible{outline:2px solid #c6dfff;outline-offset:7px;border-radius:7px}.ds-visitor:disabled{cursor:default}.ds-visitor-name{font-size: 16px;\n  font-weight: 600;\n  margin-top: 14px;}.ds-visitor-description{font-size: 11px;\n  color: #dce8ff;\n  margin-top: 6px;}.ds-enter{display: flex;\n  align-items: center;\n  gap: 11px;\n  background: #e6f0ff20;\n  padding: 10px 17px;\n  border-radius: 7px;\n  margin-top: 22px;\n  font-size: 12px;\n  min-height: 38px;}@media(max-height:650px){.ds-avatar{width:63px;height:63px}.ds-enter{margin-top:10px}}@media(prefers-reduced-motion:reduce){.ds-avatar{transition:none}}"
    },
    {
      "name": "Boot progress",
      "kind": "custom",
      "refersTo": "boot-progress",
      "description": "Decorative progress fill accompanies the announced startup status.",
      "html": "<div class=\"ds-boot\"><span class=\"ds-monogram\" aria-hidden=\"true\">IR<span>.</span></span><div class=\"ds-progress\" aria-hidden=\"true\"><span></span></div><p role=\"status\">Iniciando tu espacio de trabajo...</p></div>",
      "css": ".ds-boot{font-family:-apple-system,BlinkMacSystemFont,sans-serif;display:flex;flex-direction:column;align-items:center;background:#06142c;color:#f2f6ff;padding:32px}.ds-monogram{font-size: 83px;\n  font-weight: 700;\n  letter-spacing: -0.04em;\n  line-height: 1;}.ds-monogram>span{color:#7bb7ff}.ds-progress{width: 166px;\n  height: 3px;\n  overflow: hidden;\n  background: #293c5d;\n  border-radius: 3px;margin-top:37px}.ds-progress>span{display: block;\n  height: 100%;\n  background: #d7e8ff;\n  transform-origin: left;\n  animation: ds-boot-load 1700ms cubic-bezier(0.25, 0.1, 0.2, 1) both;}.ds-boot p{margin-top: 16px;\n  color: #b0c3e1;\n  font-size: 11px;}@keyframes ds-boot-load{from{transform:scaleX(.02)}to{transform:scaleX(1)}}@media(prefers-reduced-motion:reduce){.ds-progress>span{animation:none}}"
    },
    {
      "name": "Immersive dock",
      "kind": "nav",
      "refersTo": "immersive-dock",
      "description": "Revealed dock appearance when a visible window is maximized. Application JavaScript handles edge reveal, 450/2500ms hiding and 3000ms pointer tooltip dwell; keyboard focus reveals immediately.",
      "html": "<nav class=\"ds-immersive-dock\" aria-label=\"Aplicaciones del sistema\"><button class=\"ds-dock-app\" aria-label=\"Abrir Contacto\"><span class=\"ds-dock-icon\"><svg width=\"29\" height=\"29\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M22 2 7 9l6 2 2 6 7-15Z\"/><path d=\"m7 9-5 2 11 2 2 9 2-5\"/></svg></span><span class=\"ds-dock-tooltip\">Contacto</span><span class=\"ds-dock-label\">Contacto</span></button></nav>",
      "css": ".ds-immersive-dock{display:inline-flex;align-items:center;gap:17px;padding:13px 18px 8px;border-radius:19px;background:#15386be6;backdrop-filter:blur(25px) saturate(150%);box-shadow:inset 0 0 0 1px #ffffff35,0 10px 30px #00113430;height:91px;font-family:-apple-system,BlinkMacSystemFont,sans-serif}.ds-dock-app{position:relative;background:transparent;border:0;padding:0;display:flex;flex-direction:column;align-items:center;min-width:57px;gap:5px;color:#fff;cursor:pointer}.ds-dock-icon{display:inline-flex;align-items:center;justify-content:center;width:48px;height:48px;border-radius:12px;background:linear-gradient(150deg,#239bff,#0454e8);box-shadow:inset 0 1px 1px #ffffff70,inset 0 -1px 2px #0002,0 4px 7px #00113b30;transition:transform .22s cubic-bezier(.16,1,.3,1)}.ds-dock-app:hover .ds-dock-icon{transform:translateY(-7px) scale(1.08)}.ds-dock-label{font-size:9px;text-shadow:0 1px 3px #001536}.ds-dock-tooltip{position:absolute;bottom:78px;opacity:0;pointer-events:none;font-size:11px;color:var(--os-ink,#182238);padding:5px 10px;background:var(--os-surface,#fafafa);border-radius:5px;white-space:nowrap;box-shadow:0 4px 12px #00133630}.ds-dock-app:focus-visible{outline:3px solid #3287ff;outline-offset:4px;border-radius:5px}.ds-dock-app:focus-visible .ds-dock-tooltip{opacity:1}@media(prefers-reduced-motion:reduce){.ds-dock-icon{transition:none}.ds-dock-app:hover .ds-dock-icon{transform:none}}"
    },
    {
      "name": "Desktop selection marquee",
      "kind": "custom",
      "refersTo": "selection-box",
      "description": "Blue rectangle drawn on empty-desktop left-pointer drag; intersects launcher targets to select them. The rectangle itself never intercepts pointer events.",
      "html": "<div class=\"ds-selection-box\" aria-hidden=\"true\"></div>",
      "css": ".ds-selection-box{position:relative;width:180px;height:110px;z-index:10;pointer-events:none;background:#2b85ef35;border:1px solid #70b5ff}"
    },
    {
      "name": "Calculator keys",
      "kind": "button",
      "refersTo": "calculator-key",
      "description": "Neutral digit keys and primary-blue equals key in the four-column calculator keypad; 48px high on desktop and 56px on mobile.",
      "html": "<div class=\"ds-calc-keys\"><button>7</button><button>8</button><button>9</button><button class=\"ds-calc-operator\" aria-label=\"Sumar\">+</button><button>0</button><button aria-label=\"Separador decimal\">,</button><button aria-label=\"Borrar todo\">AC</button><button class=\"ds-calc-equals\" aria-label=\"Igual\">=</button></div>",
      "css": ".ds-calc-keys{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;max-width:288px}.ds-calc-keys button{font-family:-apple-system,BlinkMacSystemFont,sans-serif;border:0;cursor:pointer;height:48px;border-radius:8px;background:var(--os-soft,#edf1f8);color:var(--os-ink,#182238);font-size:20px;font-weight:400}.ds-calc-keys button:hover{filter:brightness(.95)}.ds-calc-keys button:active{filter:brightness(.87)}.ds-calc-keys button:focus-visible{outline:3px solid #3287ff;outline-offset:4px;border-radius:5px}.ds-calc-keys .ds-calc-operator{color:var(--os-blue,#0757ed)}.ds-calc-keys .ds-calc-equals{background:var(--os-blue,#0757ed);color:#fff}@media(max-width:900px){.ds-calc-keys button{height:56px}}"
    },
    {
      "name": "Notepad editor",
      "kind": "input",
      "refersTo": "notepad-editor",
      "description": "Local notes editor with monospace text and inset focus outline. Application code handles debounce, unmount flush and TXT download.",
      "html": "<textarea class=\"ds-notepad\" aria-label=\"Contenido del bloc de notas\" placeholder=\"Una idea, un recordatorio, el comienzo de algo...\"></textarea>",
      "css": ".ds-notepad{display:block;resize:vertical;width:100%;min-height:310px;padding:23px;font:13px/1.9 ui-monospace,SFMono-Regular,Consolas,monospace;color:var(--os-ink,#182238);background:var(--os-surface,#fafafa);border:0;outline:none;caret-color:var(--os-blue,#0757ed)}.ds-notepad::placeholder{color:var(--os-muted,#56617a);opacity:1}.ds-notepad:focus-visible{outline:2px solid var(--os-blue,#0757ed);outline-offset:-3px}@media(max-width:900px){.ds-notepad{padding:20px 16px;min-height:350px}}"
    }
  ],
  "narrative": {
    "northStar": "The personal desktop",
    "overview": "The portfolio is a clean, explorable desktop inspired by macOS. Ocean-blue folded waves provide room around compact project applications and softly elevated windows. The user explicitly replaced the earlier editorial direction in `idea.md`; the approved reference is `.impeccable/mocks/desktop-apps-small.png`.\n\nReal project screenshots, semantic vector pictograms and native-style controls carry the experience. The interface stays compact while keeping projects, professional information, CV and contact accessible through windows, search and the dock.\n\nA brief first-PC-style boot sequence leads to a password-free Visitante selection before the desktop. It extends the same blue world with a dark startup surface, a pale monogram and a blurred version of the existing ocean wallpaper. Returning within the same browser tab resumes the desktop.",
    "keyCharacteristics": [
      "Ocean-blue wallpaper and light application surfaces.",
      "Compact project launchers with meaningful icons.",
      "Independent windows with familiar title bars and traffic-light controls.",
      "Responsive sheets and visible keyboard focus.",
      "A short boot sequence and one clear visitor entry point."
    ],
    "rules": [],
    "dos": [
      "**Do** preserve the approved compact desktop metaphor and meaningful application icons.",
      "**Do** use the existing project data and real screenshots.",
      "**Do** keep visible focus, labeled controls and reduced-motion behavior.",
      "**Do** use three launcher columns and fixed application sheets on mobile."
    ],
    "donts": [
      "**Don't** restore the superseded editorial direction from `idea.md`.",
      "**Don't** invent clients, experience, metrics or project previews.",
      "**Don't** make minimized windows lose their local state."
    ]
  }
}
